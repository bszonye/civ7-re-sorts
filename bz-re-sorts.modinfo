<?xml version="1.0" encoding="utf-8"?>
<Mod id="bz-re-sorts" version="3.0.0"
    xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_BZ_RE_SORTS_NAME</Name>
        <Version>3.0.0</Version>
        <Description>LOC_MOD_BZ_RE_SORTS_DESCRIPTION</Description>
        <Authors>beezany</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <bzIcon>blp:ntf_discover_resource</bzIcon>
        <bzIconGlow>#66bbff</bzIconGlow>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="bz-re-sorts-ui" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <ImportFiles>
                    <Item>ui-next/screens/commerce/commerce-criteria-display.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-base-tab-content.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-empire-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-model.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-resources-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-trade-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-treasure-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.css</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.scss.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.scss2.js</Item>
                    <Item>ui-next/screens/commerce/factory-type-display.js</Item>
                    <Item>ui-next/screens/commerce/trade-route-card.js</Item>
                    <Item>ui-next/screens/commerce/treasure-convoy-card.js</Item>
                    <Item>ui-next/screens/commerce/treasure-convoy-progress-bar.js</Item>
                </ImportFiles>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                </UpdateText>
                -->
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
