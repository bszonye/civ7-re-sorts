        <Name>LOC_MOD_BZ_RE_SORTS_NAME</Name>
        <Version>3.0.0</Version>
        <Description>LOC_MOD_BZ_RE_SORTS_DESCRIPTION</Description>
        <Authors>beezany</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <bzIcon>blp:ntf_discover_resource_blk</bzIcon>
        <bzIconGlow>#ff9900</bzIconGlow>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
    </ActionCriteria>
